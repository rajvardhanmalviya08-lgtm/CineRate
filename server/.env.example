# CineRate Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/cinerate
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cinerate?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/cinerate

# JWT Secret for User Authentication
JWT_SECRET=cinerate_super_secret_jwt_key_2026_cinematic_auth

# TMDB (The Movie Database) API Configuration
# Get your free TMDB API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Client URL for CORS
CLIENT_URL=http://localhost:5173

